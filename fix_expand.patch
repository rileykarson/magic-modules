+func expandReservedResourcesConfig(v interface{}) *container.ReservedResourcesConfig {
+	if v == nil {
+		return nil
+	}
+	ls := v.([]interface{})
+	if len(ls) == 0 || ls[0] == nil {
+		return nil
+	}
+	cfg := ls[0].(map[string]interface{})
+	result := &container.ReservedResourcesConfig{}
+	if val, ok := cfg["cpu_reserved_millicore"]; ok && val != nil {
+		result.CpuReservedMillicore = int64(val.(int))
+	}
+	if val, ok := cfg["memory_reserved_mib"]; ok && val != nil {
+		result.MemoryReservedMib = int64(val.(int))
+	}
+	return result
+}
