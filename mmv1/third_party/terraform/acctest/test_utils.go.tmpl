func getFullSDKServer() tfprotov5.ProviderServer {
	return initBaseSDKProvider().GRPCProvider()
}

func getFullFWServer() tfprotov5.ProviderServer {
	return providerserver.NewProtocol5(NewFrameworkTestProvider("", initBaseSDKProvider()))()
}

func getFullMuxServer() tfprotov5.ProviderServer {
	fullMuxServerOnce.Do(func() {
		srv, _ := tf5muxserver.NewMuxServer(context.Background(),
			func() tfprotov5.ProviderServer {
				return &cachedProviderServer{
					ProviderServer: getFullSDKServer(),
					fullServer:     getFullSDKServer,
					cache:          &sdkProviderSchemaCache,
				}
			},
			func() tfprotov5.ProviderServer {
				return &cachedProviderServer{
					ProviderServer: getFullFWServer(),
					fullServer:     getFullFWServer,
					cache:          &fwProviderSchemaCache,
				}
			},
		)
		fullMuxServer = srv.ProviderServer()
	})
	return fullMuxServer
}

