func (s *cachedProviderServer) GetProviderSchema(ctx context.Context, req *tfprotov5.GetProviderSchemaRequest) (*tfprotov5.GetProviderSchemaResponse, error) {
	s.cache.schemaOnce.Do(func() {
		s.cache.schemaResp, s.cache.schemaErr = s.fullServer().GetProviderSchema(context.Background(), req)
	})
	if s.cache.schemaErr != nil || s.cache.schemaResp == nil {
		return s.cache.schemaResp, s.cache.schemaErr
	}
	used := getUsedTypesForTest(s.testName)
	if used == nil {
		return s.cache.schemaResp, nil
	}
	base := s.cache.schemaResp
	resp := &tfprotov5.GetProviderSchemaResponse{
		Provider:                 base.Provider,
		ProviderMeta:             base.ProviderMeta,
		Functions:                base.Functions,
		ServerCapabilities:       base.ServerCapabilities,
		Diagnostics:              base.Diagnostics,
		ResourceSchemas:          make(map[string]*tfprotov5.Schema, len(used)),
		DataSourceSchemas:        make(map[string]*tfprotov5.Schema, len(used)),
		EphemeralResourceSchemas: make(map[string]*tfprotov5.Schema),
		ListResourceSchemas:      make(map[string]*tfprotov5.Schema),
		ActionSchemas:            make(map[string]*tfprotov5.ActionSchema),
	}
	for k := range used {
		if v, ok := base.ResourceSchemas[k]; ok {
			resp.ResourceSchemas[k] = v
		}
		if v, ok := base.DataSourceSchemas[k]; ok {
			resp.DataSourceSchemas[k] = v
		}
		if v, ok := base.EphemeralResourceSchemas[k]; ok {
			resp.EphemeralResourceSchemas[k] = v
		}
		if v, ok := base.ListResourceSchemas[k]; ok {
			resp.ListResourceSchemas[k] = v
		}
		if v, ok := base.ActionSchemas[k]; ok {
			resp.ActionSchemas[k] = v
		}
	}
	return resp, nil
}

func (s *cachedProviderServer) GetMetadata(ctx context.Context, req *tfprotov5.GetMetadataRequest) (*tfprotov5.GetMetadataResponse, error) {
	s.cache.metaOnce.Do(func() {
		s.cache.metaResp, s.cache.metaErr = s.fullServer().GetMetadata(context.Background(), req)
	})
	if s.cache.metaErr != nil || s.cache.metaResp == nil {
		return s.cache.metaResp, s.cache.metaErr
	}
	used := getUsedTypesForTest(s.testName)
	if used == nil {
		return s.cache.metaResp, nil
	}
	base := s.cache.metaResp
	resp := &tfprotov5.GetMetadataResponse{
		Functions:          base.Functions,
		ServerCapabilities: base.ServerCapabilities,
		Diagnostics:        base.Diagnostics,
		Resources:          make([]tfprotov5.ResourceMetadata, 0, len(used)),
		DataSources:        make([]tfprotov5.DataSourceMetadata, 0, len(used)),
		EphemeralResources: make([]tfprotov5.EphemeralResourceMetadata, 0),
		ListResources:      make([]tfprotov5.ListResourceMetadata, 0),
		Actions:            make([]tfprotov5.ActionMetadata, 0),
	}
	for _, r := range base.Resources {
		if _, ok := used[r.TypeName]; ok {
			resp.Resources = append(resp.Resources, r)
		}
	}
	for _, d := range base.DataSources {
		if _, ok := used[d.TypeName]; ok {
			resp.DataSources = append(resp.DataSources, d)
		}
	}
	for _, e := range base.EphemeralResources {
		if _, ok := used[e.TypeName]; ok {
			resp.EphemeralResources = append(resp.EphemeralResources, e)
		}
	}
	for _, l := range base.ListResources {
		if _, ok := used[l.TypeName]; ok {
			resp.ListResources = append(resp.ListResources, l)
		}
	}
	for _, a := range base.Actions {
		if _, ok := used[a.TypeName]; ok {
			resp.Actions = append(resp.Actions, a)
		}
	}
	return resp, nil
}

