// Force VCR re-record to fix ambient flake
func TestAccDataformConfig_update(t *testing.T) {
	t.Parallel()

	context := map[string]interface{}{
		"billing_account": envvar.GetTestBillingAccountFromEnv(t),
		"org_id":          envvar.GetTestOrgFromEnv(t),
		"random_suffix":   acctest.RandString(t, 10),
	}

	acctest.VcrTest(t, resource.TestCase{
		PreCheck:                 func() { acctest.AccTestPreCheck(t) },
		ProtoV5ProviderFactories: acctest.ProtoV5ProviderBetaFactories(t),
		ExternalProviders: map[string]resource.ExternalProvider{
			"time": {},
		},
		Steps: []resource.TestStep{
			{
				Config: testAccDataformConfig_full(acctest.MergeMap(context, map[string]interface{}{
					"default_kms_key_name": `google_kms_crypto_key.key_1.id`,
				})),
			},
			{
				ResourceName:            "google_dataform_config.config",
				ImportState:             true,
				ImportStateVerify:       true,
				ImportStateVerifyIgnore: []string{"region"},
			},
			{
				Config: testAccDataformConfig_full(acctest.MergeMap(context, map[string]interface{}{
					"default_kms_key_name": `google_kms_crypto_key.key_2.id`,
				})),
				ConfigPlanChecks: resource.ConfigPlanChecks{
					PreApply: []plancheck.PlanCheck{
						plancheck.ExpectResourceAction("google_dataform_config.config", plancheck.ResourceActionUpdate),
					},
				},
			},
			{
				ResourceName:            "google_dataform_config.config",
				ImportState:             true,
				ImportStateVerify:       true,
				ImportStateVerifyIgnore: []string{"region"},
			},
			{
				Config: testAccDataformConfig_full(acctest.MergeMap(context, map[string]interface{}{
					"default_kms_key_name": nil,
				})),
				ConfigPlanChecks: resource.ConfigPlanChecks{
					PreApply: []plancheck.PlanCheck{
						plancheck.ExpectResourceAction("google_dataform_config.config", plancheck.ResourceActionUpdate),
					},
				},
			},
			{
				ResourceName:            "google_dataform_config.config",
				ImportState:             true,
				ImportStateVerify:       true,
				ImportStateVerifyIgnore: []string{"region"},
			},
		},
	})
}

func testAccDataformConfig_full(context map[string]interface{}) string {
	return acctest.Nprintf(`
resource "google_sourcerepo_repository" "git_repository" {
  name = "tf-test-my-repository%{random_suffix}"
}

resource "google_secret_manager_secret" "secret" {
  secret_id = "tf-test-my-secret%{random_suffix}"

  replication {
    auto {}
  }
}

resource "google_secret_manager_secret_version" "secret_version" {
  secret = google_secret_manager_secret.secret.id

  secret_data = "secret-data"
}

resource "google_kms_key_ring" "keyring" {
  name     = "tf-test-my-keyring%{random_suffix}"
  location = "us-central1"
}

resource "google_kms_crypto_key" "key_1" {
  name            = "tf-test-my-crypto-key-1%{random_suffix}"
  key_ring        = google_kms_key_ring.keyring.id
  purpose         = "ENCRYPT_DECRYPT"
}

resource "google_kms_crypto_key" "key_2" {
  name            = "tf-test-my-crypto-key-2%{random_suffix}"
  key_ring        = google_kms_key_ring.keyring.id
  purpose         = "ENCRYPT_DECRYPT"
}

data "google_project" "project" {}

resource "google_project_iam_member" "kms_crypto_key_binding" {
  project  = data.google_project.project.project_id
  role     = "roles/cloudkms.cryptoKeyEncrypterDecrypter"
  member   = "serviceAccount:service-${data.google_project.project.number}@gcp-sa-dataform.iam.gserviceaccount.com"
}

resource "google_dataform_repository" "dataform_res" {
  name = "tf-test-dataform-res%{random_suffix}"
  region = "us-central1"
  git_remote_settings {
    url = google_sourcerepo_repository.git_repository.url
    default_branch = "main"
    authentication_token_secret_version = google_secret_manager_secret_version.secret_version.id
  }
}

resource "google_dataform_repository_release_config" "release" {
  project = google_dataform_repository.dataform_res.project
  region = google_dataform_repository.dataform_res.region
  repository = google_dataform_repository.dataform_res.name

  name = "tf-test-my-release%{random_suffix}"
  git_commitish = "main"
  cron_schedule = "0 7 * * *"
  time_zone = "America/New_York"
  code_compilation_config {
    default_database = "gcp-example-project"
    default_schema = "example-dataset"
    default_location = "us-central1"
    assertion_schema = "example-assertion-dataset"
    database_suffix = ""
    schema_suffix = ""
    table_prefix = ""
    vars = {
      var1 = "value2"
    }
  }
}

resource "google_dataform_repository_workflow_config" "workflow" {
  project = google_dataform_repository.dataform_res.project
  region = google_dataform_repository.dataform_res.region
  repository = google_dataform_repository.dataform_res.name

  name = "tf-test-my-workflow%{random_suffix}"
  release_config = google_dataform_repository_release_config.release.id
  invocation_config {
    included_targets {
      database = "gcp-example-project"
      schema = "example-dataset"
      name = "target1"
    }
    included_targets {
      database = "gcp-example-project"
      schema = "example-dataset"
      name = "target2"
    }
    included_tags = ["tag1"]
    transitive_dependencies_included = true
    transitive_dependents_included = true
    fully_refresh_incremental_tables_enabled = false
  }
  cron_schedule = "0 7 * * *"
  time_zone = "America/New_York"
}

resource "google_dataform_repository_workspace" "workspace" {
  project = google_dataform_repository.dataform_res.project
  region = google_dataform_repository.dataform_res.region
  repository = google_dataform_repository.dataform_res.name
  name = "tf-test-my-workspace%{random_suffix}"
}

resource "google_dataform_repository_workflow_config" "workflow2" {
  project = google_dataform_repository.dataform_res.project
  region = google_dataform_repository.dataform_res.region
  repository = google_dataform_repository.dataform_res.name

  name = "tf-test-my-workflow2%{random_suffix}"
  release_config = google_dataform_repository_release_config.release.id
  invocation_config {
    included_targets {
      database = "gcp-example-project"
      schema = "example-dataset"
      name = "target1"
    }
    included_targets {
      database = "gcp-example-project"
      schema = "example-dataset"
      name = "target2"
    }
    included_tags = ["tag1"]
    transitive_dependencies_included = true
    transitive_dependents_included = true
    fully_refresh_incremental_tables_enabled = false
  }
  cron_schedule = "0 7 * * *"
  time_zone = "America/New_York"
}

resource "google_dataform_repository_workspace" "workspace2" {
  project = google_dataform_repository.dataform_res.project
  region = google_dataform_repository.dataform_res.region
  repository = google_dataform_repository.dataform_res.name
  name = "tf-test-my-workspace2%{random_suffix}"
}

resource "google_dataform_config" "project_config" {
  project = data.google_project.project.project_id
  region = "us-central1"
  default_kms_key_name = %{default_kms_key_name}

  depends_on = [
    google_project_iam_member.kms_crypto_key_binding
