func TestPerformanceMonitoringUnitStandardPlan(t *testing.T) {
	t.Parallel()

	d := schema.TestResourceDataRaw(t, map[string]*schema.Schema{
		"node_config": schemaNodeConfig(),
	}, map[string]interface{}{
		"node_config": []interface{}{
			map[string]interface{}{
				"advanced_machine_features": []interface{}{
					map[string]interface{}{
						"threads_per_core":            2,
						"performance_monitoring_unit": "STANDARD",
					},
				},
			},
		},
	})

	if got := d.Get("node_config.0.advanced_machine_features.0.performance_monitoring_unit"); got != "STANDARD" {
		t.Fatalf("performance_monitoring_unit = STANDARD planned as %q", got)
	}
}

func TestPerformanceMonitoringUnitExistingResourcePlan(t *testing.T) {
	t.Parallel()

	nodeConfigResource := schemaNodeConfig().Elem.(*schema.Resource)
	advancedMachineFeatures := nodeConfigResource.Schema["advanced_machine_features"].Elem.(*schema.Resource)
	pmu := advancedMachineFeatures.Schema["performance_monitoring_unit"]
	resource := &schema.Resource{Schema: map[string]*schema.Schema{
		"performance_monitoring_unit": pmu,
	}}
	state := &terraform.InstanceState{
		ID: "existing",
		Attributes: map[string]string{
			"performance_monitoring_unit": "",
		},
	}
	config := terraform.NewResourceConfigRaw(map[string]interface{}{
		"performance_monitoring_unit": "STANDARD",
	})

	diff, err := resource.Diff(context.Background(), state, config, nil)
	if err != nil {
		t.Fatalf("planning existing resource: %s", err)
	}
	if diff != nil {
		t.Fatalf("existing resource unexpectedly planned empty to STANDARD change: %#v", diff.Attributes)
	}
}

func TestPerformanceMonitoringUnitDiffSuppress(t *testing.T) {
	t.Parallel()

	nodeConfigResource := schemaNodeConfig().Elem.(*schema.Resource)
	advancedMachineFeatures := nodeConfigResource.Schema["advanced_machine_features"].Elem.(*schema.Resource)
	pmu := advancedMachineFeatures.Schema["performance_monitoring_unit"]
	if pmu.ForceNew {
		t.Fatal("performance_monitoring_unit must not unexpectedly replace existing node pools")
	}
	if pmu.DiffSuppressFunc == nil {
		t.Fatal("performance_monitoring_unit must have a compatibility diff suppressor")
	}

	newResource := schema.TestResourceDataRaw(t, map[string]*schema.Schema{}, map[string]interface{}{})
	existingResource := schema.TestResourceDataRaw(t, map[string]*schema.Schema{}, map[string]interface{}{})
	existingResource.SetId("existing")

	cases := map[string]struct {
		old, new string
		data     *schema.ResourceData
		want     bool
	}{
		"new resource preserves standard":                       {old: "", new: "STANDARD", data: newResource, want: false},
		"existing resource suppresses empty to standard":        {old: "", new: "STANDARD", data: existingResource, want: true},
		"existing resource suppresses standard to empty":        {old: "STANDARD", new: "", data: existingResource, want: true},
		"existing resource preserves empty to architectural":    {old: "", new: "ARCHITECTURAL", data: existingResource, want: false},
		"existing resource preserves architectural to standard": {old: "ARCHITECTURAL", new: "STANDARD", data: existingResource, want: false},
		"nil resource does not suppress":                         {old: "", new: "STANDARD", data: nil, want: false},
	}

	for name, tc := range cases {
		t.Run(name, func(t *testing.T) {
			if got := pmu.DiffSuppressFunc("performance_monitoring_unit", tc.old, tc.new, tc.data); got != tc.want {
				t.Fatalf("DiffSuppressFunc(%q, %q) = %t, want %t", tc.old, tc.new, got, tc.want)
			}
		})
	}
}

func TestUnitFlattenNodePool(t *testing.T) {
	t.Parallel()

	// nodeCountFromAPI is the size the prepopulated IGM cache reports; the
	// standard-flow case expects flattenNodePool to surface exactly this.
	const nodeCountFromAPI = 5

	resourceSchema := map[string]*schema.Schema{
		"ignore_node_count_changes": {
			Type:     schema.TypeBool,
			Optional: true,
			Default:  false,
		},
		"node_count": {
			Type:     schema.TypeInt,
			Optional: true,
			Computed: true,
		},
		"initial_node_count": {
			Type:     schema.TypeInt,
			Optional: true,
		},
		"node_config": {
			Type:     schema.TypeList,
			Optional: true,
			Elem:     &schema.Resource{Schema: map[string]*schema.Schema{"machine_type": {Type: schema.TypeString}}},
		},
		"name_prefix": {
			Type:     schema.TypeString,
			Optional: true,
		},
		"network_config": {
			Type:     schema.TypeList,
			Optional: true,
			Elem:     &schema.Resource{Schema: map[string]*schema.Schema{"create_pod_range": {Type: schema.TypeBool}}},
		},
	}

	cases := []struct {
		name                   string
		d                      *schema.ResourceData
		np                     *container.NodePool
		prepopulateCache       bool
		expectedNodeCount      int
		expectedIgmUrls        []string
		expectedManagedIgmUrls []string
	}{
		{
			name: "Standard flow (ignore_node_count_changes=false) fetches from IGM",
			d:    schema.TestResourceDataRaw(t, resourceSchema, map[string]interface{}{}),
			np: &container.NodePool{
				Name: "pool-1",
				InstanceGroupUrls: []string{
					"https://www.googleapis.com/compute/v1/projects/ci-project/zones/us-central1-a/instanceGroupManagers/gke-pool-1-grp",
				},
				Locations: []string{"us-central1-a"},
			},
			prepopulateCache:  true,
			expectedNodeCount: nodeCountFromAPI,
			expectedIgmUrls: []string{
				"https://www.googleapis.com/compute/v1/projects/ci-project/zones/us-central1-a/instanceGroupManagers/gke-pool-1-grp",
			},
			expectedManagedIgmUrls: []string{
				"https://www.googleapis.com/compute/v1/projects/ci-project/zones/us-central1-a/instanceGroups/gke-pool-1-grp",
			},
		},
		{
			name: "Skip flow (ignore_node_count_changes=true) reads from state",
			d: schema.TestResourceDataRaw(t, resourceSchema, map[string]interface{}{
				"ignore_node_count_changes": true,
				"node_count":              10,
			}),
			np: &container.NodePool{
				Name:              "pool-1",
				InitialNodeCount:  3,
				InstanceGroupUrls: []string{"https://www.googleapis.com/compute/v1/projects/ci-project/zones/us-central1-a/instanceGroupManagers/gke-pool-1-grp"},
				Locations:         []string{"us-central1-a"},
			},
			prepopulateCache:  false, // Cache is empty, proving we skipped the API fetch
			expectedNodeCount: 10,
			expectedIgmUrls: []string{
				"https://www.googleapis.com/compute/v1/projects/ci-project/zones/us-central1-a/instanceGroupManagers/gke-pool-1-grp",
			},
			expectedManagedIgmUrls: []string{}, // Unpopulated because IGM query was skipped
		},
		{
			name: "Skip flow (ignore_node_count_changes=true) falls back to InitialNodeCount when no state",
			d: schema.TestResourceDataRaw(t, resourceSchema, map[string]interface{}{
				"ignore_node_count_changes": true,
			}),
			np: &container.NodePool{
				Name:              "pool-1",
				InitialNodeCount:  3,
				InstanceGroupUrls: []string{"https://www.googleapis.com/compute/v1/projects/ci-project/zones/us-central1-a/instanceGroupManagers/gke-pool-1-grp"},
				Locations:         []string{"us-central1-a"},
			},
			prepopulateCache:  false,
			expectedNodeCount: 3,
			expectedIgmUrls: []string{
				"https://www.googleapis.com/compute/v1/projects/ci-project/zones/us-central1-a/instanceGroupManagers/gke-pool-1-grp",
			},
			expectedManagedIgmUrls: []string{},
		},
	}

	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {
			// Prepopulate cache if requested
			if tc.prepopulateCache {
				igmCache.mutex.Lock()
				igmCache.instanceGroupManagers["projects/ci-project/zones/us-central1-a/instanceGroupManagers/gke-pool-1-grp"] = &instanceGroupManagerWithUpdateTime{
					instanceGroupManager: map[string]interface{}{
						"name":          "gke-pool-1-grp",
						"targetSize":    float64(nodeCountFromAPI),
						"instanceGroup": "https://www.googleapis.com/compute/v1/projects/ci-project/zones/us-central1-a/instanceGroups/gke-pool-1-grp",
						"selfLink":      "https://www.googleapis.com/compute/v1/projects/ci-project/zones/us-central1-a/instanceGroupManagers/gke-pool-1-grp",
					},
					updateTime: time.Now(),
				}
				igmCache.mutex.Unlock()

				// Clean up cache after the test case
				defer func() {
					igmCache.mutex.Lock()
					delete(igmCache.instanceGroupManagers, "projects/ci-project/zones/us-central1-a/instanceGroupManagers/gke-pool-1-grp")
					igmCache.mutex.Unlock()
				}()
			}

			config := &transport_tpg.Config{}
			result, err := flattenNodePool(tc.d, config, tc.np, "")
			if err != nil {
				t.Fatalf("Unexpected error: %v", err)
			}

			if result["node_count"] != tc.expectedNodeCount {
				t.Errorf("Expected node_count %d, got %v", tc.expectedNodeCount, result["node_count"])
			}

			if diff := cmp.Diff(result["instance_group_urls"], tc.expectedIgmUrls); diff != "" {
				t.Errorf("instance_group_urls returned unexpected diff. +got, -want:\n%s", diff)
			}

			if diff := cmp.Diff(result["managed_instance_group_urls"], tc.expectedManagedIgmUrls); diff != "" {
				t.Errorf("managed_instance_group_urls returned unexpected diff. +got, -want:\n%s", diff)
			}
		})
	}
}

func TestExpandKubeletConfig_InsecureKubeletReadonlyPortEnabled(t *testing.T) {
	t.Parallel()

	cases := map[string]struct {
		input         []interface{}
		wantEnabled   bool
		wantForceSend []string
	}{
		"unset empty string does not force-send false": {
			input: []interface{}{
				map[string]interface{}{
					"cpu_manager_policy":                     "static",
					"insecure_kubelet_readonly_port_enabled": "",
				},
			},
			wantEnabled:   false,
			wantForceSend: nil,
		},
		"explicit FALSE force-sends false": {
			input: []interface{}{
				map[string]interface{}{
					"insecure_kubelet_readonly_port_enabled": "FALSE",
				},
			},
			wantEnabled:   false,
			wantForceSend: []string{"InsecureKubeletReadonlyPortEnabled"},
		},
		"explicit TRUE force-sends true": {
			input: []interface{}{
				map[string]interface{}{
					"insecure_kubelet_readonly_port_enabled": "TRUE",
				},
			},
			wantEnabled:   true,
			wantForceSend: []string{"InsecureKubeletReadonlyPortEnabled"},
		},
	}

	for name, tc := range cases {
		tc := tc
		t.Run(name, func(t *testing.T) {
			t.Parallel()
			got := expandKubeletConfig(tc.input)
			if got == nil {
				t.Fatal("expandKubeletConfig returned nil")
			}
			if got.InsecureKubeletReadonlyPortEnabled != tc.wantEnabled {
				t.Errorf("InsecureKubeletReadonlyPortEnabled = %v, want %v", got.InsecureKubeletReadonlyPortEnabled, tc.wantEnabled)
			}
			if diff := cmp.Diff(tc.wantForceSend, got.ForceSendFields); diff != "" {
				t.Errorf("ForceSendFields mismatch (-want +got):\n%s", diff)
			}
		})
	}
}

func TestExpandKubeletConfigWithRawConfig(t *testing.T) {
	t.Parallel()

	r := &schema.Resource{
		Schema: map[string]*schema.Schema{
			"node_config": schemaNodeConfig(),
		},
	}

	makeDataWithRaw := func(t *testing.T, raw map[string]interface{}, rawKC cty.Value) *schema.ResourceData {
		t.Helper()
		diff, err := r.SimpleDiff(context.Background(), nil, terraform.NewResourceConfigRaw(raw), nil)
		if err != nil {
			t.Fatalf("SimpleDiff: %v", err)
		}
		diff.RawConfig = cty.ObjectVal(map[string]cty.Value{
			"node_config": cty.ListVal([]cty.Value{
				cty.ObjectVal(map[string]cty.Value{
					"kubelet_config": cty.ListVal([]cty.Value{rawKC}),
				}),
			}),
		})
		d, err := schema.InternalMap(r.SchemaMap()).Data(nil, diff)
		if err != nil {
			t.Fatalf("Data: %v", err)
		}
		return d
	}

	t.Run("explicit false and zero values populate ForceSendFields", func(t *testing.T) {
		t.Parallel()
		raw := map[string]interface{}{
			"node_config": []interface{}{
				map[string]interface{}{
					"kubelet_config": []interface{}{
						map[string]interface{}{
							"cpu_cfs_quota":                               false,
							"shutdown_grace_period_seconds":               0,
							"shutdown_grace_period_critical_pods_seconds": 0,
							"single_process_oom_kill":                     false,
							"eviction_max_pod_grace_period_seconds":       0,
							"allowed_unsafe_sysctls":                      []interface{}{},
						},
					},
				},
			},
		}
		rawKC := cty.ObjectVal(map[string]cty.Value{
			"cpu_cfs_quota":                               cty.False,
			"shutdown_grace_period_seconds":               cty.NumberIntVal(0),
			"shutdown_grace_period_critical_pods_seconds": cty.NumberIntVal(0),
			"single_process_oom_kill":                     cty.False,
			"eviction_max_pod_grace_period_seconds":       cty.NumberIntVal(0),
			"allowed_unsafe_sysctls":                      cty.ListValEmpty(cty.String),
		})
		d := makeDataWithRaw(t, raw, rawKC)
		got := expandKubeletConfigWithRawConfig(d, "", d.Get("node_config.0.kubelet_config"))
		if got == nil {
			t.Fatal("expandKubeletConfigWithRawConfig returned nil")
		}
		if got.CpuCfsQuota {
			t.Errorf("CpuCfsQuota = true, want false")
		}
		wantForceSend := []string{
			"CpuCfsQuota",
			"ShutdownGracePeriodSeconds",
			"ShutdownGracePeriodCriticalPodsSeconds",
			"SingleProcessOomKill",
			"EvictionMaxPodGracePeriodSeconds",
			"AllowedUnsafeSysctls",
		}
		if diff := cmp.Diff(wantForceSend, got.ForceSendFields); diff != "" {
			t.Errorf("ForceSendFields mismatch (-want +got):\n%s", diff)
		}
	})

	t.Run("omitted cpu_cfs_quota defaults to true without ForceSendFields", func(t *testing.T) {
		t.Parallel()
		raw := map[string]interface{}{
			"node_config": []interface{}{
				map[string]interface{}{
					"kubelet_config": []interface{}{
						map[string]interface{}{
							"cpu_manager_policy": "static",
						},
					},
				},
			},
		}
		rawKC := cty.ObjectVal(map[string]cty.Value{
			"cpu_manager_policy":                          cty.StringVal("static"),
			"cpu_cfs_quota":                               cty.NullVal(cty.Bool),
			"shutdown_grace_period_seconds":               cty.NullVal(cty.Number),
			"shutdown_grace_period_critical_pods_seconds": cty.NullVal(cty.Number),
			"single_process_oom_kill":                     cty.NullVal(cty.Bool),
			"eviction_max_pod_grace_period_seconds":       cty.NullVal(cty.Number),
			"allowed_unsafe_sysctls":                      cty.NullVal(cty.List(cty.String)),
		})
		d := makeDataWithRaw(t, raw, rawKC)
		got := expandKubeletConfigWithRawConfig(d, "", d.Get("node_config.0.kubelet_config"))
		if got == nil {
			t.Fatal("expandKubeletConfigWithRawConfig returned nil")
		}
		if !got.CpuCfsQuota {
			t.Errorf("CpuCfsQuota = false, want true when omitted")
		}
		if len(got.ForceSendFields) != 0 {
			t.Errorf("ForceSendFields = %v, want empty", got.ForceSendFields)
		}
	})
}

func TestExpandUpgradeSettingsUpdate(t *testing.T) {
	t.Parallel()

	r := &schema.Resource{
		Schema: map[string]*schema.Schema{
			"upgrade_settings": schemaNodePool["upgrade_settings"],
		},
	}

	makeData := func(t *testing.T, priorAttrs map[string]string, rawCfg map[string]interface{}) *schema.ResourceData {
		t.Helper()
		prior := &terraform.InstanceState{
			ID:         "np-id",
			Attributes: priorAttrs,
		}
		diff, err := r.SimpleDiff(context.Background(), prior, terraform.NewResourceConfigRaw(rawCfg), nil)
		if err != nil {
			t.Fatalf("SimpleDiff: %v", err)
		}
		d, err := schema.InternalMap(r.SchemaMap()).Data(prior, diff)
		if err != nil {
			t.Fatalf("Data: %v", err)
		}
		return d
	}

	t.Run("transition SURGE to BLUE_GREEN with max_surge reset to 0 succeeds", func(t *testing.T) {
		t.Parallel()
		d := makeData(t, map[string]string{
			"id":                                "np-id",
			"upgrade_settings.#":                "1",
			"upgrade_settings.0.strategy":       "SURGE",
			"upgrade_settings.0.max_surge":       "2",
			"upgrade_settings.0.max_unavailable": "1",
		}, map[string]interface{}{
			"upgrade_settings": []interface{}{
				map[string]interface{}{
					"strategy":        "BLUE_GREEN",
					"max_surge":       0,
					"max_unavailable": 0,
					"blue_green_settings": []interface{}{
						map[string]interface{}{
							"node_pool_soak_duration": "100s",
							"standard_rollout_policy": []interface{}{
								map[string]interface{}{
									"batch_percentage":    0.5,
									"batch_soak_duration": "10s",
								},
							},
						},
					},
				},
			},
		})
		got, err := expandUpgradeSettingsUpdate(d, "")
		if err != nil {
			t.Fatalf("unexpected error transitioning SURGE -> BLUE_GREEN: %v", err)
		}
		if got.Strategy != "BLUE_GREEN" {
			t.Errorf("Strategy = %q, want BLUE_GREEN", got.Strategy)
		}
		if got.BlueGreenSettings == nil {
			t.Fatal("expected BlueGreenSettings to be populated")
		}
	})

	t.Run("transition BLUE_GREEN to SURGE removing blue_green_settings succeeds", func(t *testing.T) {
		t.Parallel()
		d := makeData(t, map[string]string{
			"id":                                                                                     "np-id",
			"upgrade_settings.#":                                                                     "1",
			"upgrade_settings.0.strategy":                                                            "BLUE_GREEN",
			"upgrade_settings.0.max_surge":                                                           "0",
			"upgrade_settings.0.max_unavailable":                                                     "0",
			"upgrade_settings.0.blue_green_settings.#":                                               "1",
			"upgrade_settings.0.blue_green_settings.0.node_pool_soak_duration":                       "100s",
			"upgrade_settings.0.blue_green_settings.0.standard_rollout_policy.#":                     "1",
			"upgrade_settings.0.blue_green_settings.0.standard_rollout_policy.0.batch_percentage":    "0.5",
			"upgrade_settings.0.blue_green_settings.0.standard_rollout_policy.0.batch_soak_duration": "10s",
		}, map[string]interface{}{
			"upgrade_settings": []interface{}{
				map[string]interface{}{
					"strategy":           "SURGE",
					"max_surge":          2,
					"max_unavailable":    0,
					"blue_green_settings": []interface{}{},
				},
			},
		})
		got, err := expandUpgradeSettingsUpdate(d, "")
		if err != nil {
			t.Fatalf("unexpected error transitioning BLUE_GREEN -> SURGE: %v", err)
		}
		if got.Strategy != "SURGE" {
			t.Errorf("Strategy = %q, want SURGE", got.Strategy)
		}
		if got.MaxSurge != 2 {
			t.Errorf("MaxSurge = %d, want 2", got.MaxSurge)
		}
		if got.BlueGreenSettings != nil {
			t.Errorf("BlueGreenSettings = %+v, want nil", got.BlueGreenSettings)
		}
	})

	t.Run("setting non-zero max_surge with BLUE_GREEN strategy errors", func(t *testing.T) {
		t.Parallel()
		d := makeData(t, map[string]string{
			"id":                                "np-id",
			"upgrade_settings.#":                "1",
			"upgrade_settings.0.strategy":       "BLUE_GREEN",
			"upgrade_settings.0.max_surge":       "0",
			"upgrade_settings.0.max_unavailable": "0",
		}, map[string]interface{}{
			"upgrade_settings": []interface{}{
				map[string]interface{}{
					"strategy":  "BLUE_GREEN",
					"max_surge": 2,
				},
			},
		})
		if _, err := expandUpgradeSettingsUpdate(d, ""); err == nil {
			t.Fatal("expected error when setting non-zero max_surge with BLUE_GREEN strategy, got nil")
		}
	})

	t.Run("updating max_surge to 0 with SURGE strategy sets ForceSendFields", func(t *testing.T) {
		t.Parallel()
		d := makeData(t, map[string]string{
			"id":                                "np-id",
			"upgrade_settings.#":                "1",
			"upgrade_settings.0.strategy":       "SURGE",
			"upgrade_settings.0.max_surge":       "2",
			"upgrade_settings.0.max_unavailable": "1",
		}, map[string]interface{}{
			"upgrade_settings": []interface{}{
				map[string]interface{}{
					"strategy":        "SURGE",
					"max_surge":       0,
					"max_unavailable": 1,
				},
			},
		})
		got, err := expandUpgradeSettingsUpdate(d, "")
		if err != nil {
			t.Fatalf("unexpected error: %v", err)
		}
		if diff := cmp.Diff([]string{"MaxSurge"}, got.ForceSendFields); diff != "" {
			t.Errorf("ForceSendFields mismatch (-want +got):\n%s", diff)
		}
	})

	t.Run("updating standard_rollout_policy batch_node_count to 0 sets ForceSendFields", func(t *testing.T) {
		t.Parallel()
		d := makeData(t, map[string]string{
			"id":                                                                                   "np-id",
			"upgrade_settings.#":                                                                   "1",
			"upgrade_settings.0.strategy":                                                          "BLUE_GREEN",
			"upgrade_settings.0.blue_green_settings.#":                                             "1",
			"upgrade_settings.0.blue_green_settings.0.node_pool_soak_duration":                     "100s",
			"upgrade_settings.0.blue_green_settings.0.standard_rollout_policy.#":                   "1",
			"upgrade_settings.0.blue_green_settings.0.standard_rollout_policy.0.batch_node_count":  "1",
			"upgrade_settings.0.blue_green_settings.0.standard_rollout_policy.0.batch_soak_duration": "10s",
		}, map[string]interface{}{
			"upgrade_settings": []interface{}{
				map[string]interface{}{
					"strategy": "BLUE_GREEN",
					"blue_green_settings": []interface{}{
						map[string]interface{}{
							"node_pool_soak_duration": "100s",
							"standard_rollout_policy": []interface{}{
								map[string]interface{}{
									"batch_node_count":    0,
									"batch_soak_duration": "10s",
								},
							},
						},
					},
				},
			},
		})
		got, err := expandUpgradeSettingsUpdate(d, "")
		if err != nil {
			t.Fatalf("unexpected error: %v", err)
		}
		if got.BlueGreenSettings == nil || got.BlueGreenSettings.StandardRolloutPolicy == nil {
			t.Fatal("expected StandardRolloutPolicy to be populated")
		}
		if diff := cmp.Diff([]string{"BatchNodeCount"}, got.BlueGreenSettings.StandardRolloutPolicy.ForceSendFields); diff != "" {
			t.Errorf("StandardRolloutPolicy.ForceSendFields mismatch (-want +got):\n%s", diff)
		}
	})
}

func TestExpandNodeConfigDefaults(t *testing.T) {
	t.Parallel()

	t.Run("omitted insecure_kubelet_readonly_port_enabled and logging_variant do not populate empty sub-structs", func(t *testing.T) {
		t.Parallel()
		got := expandNodeConfigDefaults([]interface{}{
			map[string]interface{}{
				"insecure_kubelet_readonly_port_enabled": "",
				"logging_variant":                        "",
				"gcfs_config": []interface{}{
					map[string]interface{}{
						"enabled": false,
					},
				},
			},
		})
		if got == nil {
			t.Fatal("expandNodeConfigDefaults returned nil")
		}
		if got.NodeKubeletConfig != nil {
			t.Errorf("NodeKubeletConfig = %+v, want nil when insecure_kubelet_readonly_port_enabled is empty", got.NodeKubeletConfig)
		}
		if got.LoggingConfig != nil {
			t.Errorf("LoggingConfig = %+v, want nil when logging_variant is empty", got.LoggingConfig)
		}
		if got.GcfsConfig == nil || got.GcfsConfig.Enabled {
			t.Fatalf("GcfsConfig = %+v, want Enabled=false", got.GcfsConfig)
		}
		if diff := cmp.Diff([]string{"Enabled"}, got.GcfsConfig.ForceSendFields); diff != "" {
			t.Errorf("GcfsConfig.ForceSendFields mismatch (-want +got):\n%s", diff)
		}
	})

	t.Run("explicit FALSE insecure_kubelet_readonly_port_enabled sets ForceSendFields", func(t *testing.T) {
		t.Parallel()
		got := expandNodeConfigDefaults([]interface{}{
			map[string]interface{}{
				"insecure_kubelet_readonly_port_enabled": "FALSE",
				"logging_variant":                        "DEFAULT",
			},
		})
		if got == nil || got.NodeKubeletConfig == nil {
			t.Fatal("expected NodeKubeletConfig to be populated")
		}
		if got.NodeKubeletConfig.InsecureKubeletReadonlyPortEnabled {
			t.Errorf("InsecureKubeletReadonlyPortEnabled = true, want false")
		}
		if diff := cmp.Diff([]string{"InsecureKubeletReadonlyPortEnabled"}, got.NodeKubeletConfig.ForceSendFields); diff != "" {
			t.Errorf("ForceSendFields mismatch (-want +got):\n%s", diff)
		}
		if got.LoggingConfig == nil || got.LoggingConfig.VariantConfig == nil || got.LoggingConfig.VariantConfig.Variant != "DEFAULT" {
			t.Errorf("LoggingConfig = %+v, want DEFAULT", got.LoggingConfig)
		}
	})
}

func TestExpandNodeDrainConfig(t *testing.T) {
	t.Parallel()

	if got := expandNodeDrainConfig(nil); got != nil {
		t.Fatalf("expandNodeDrainConfig(nil) = %+v, want nil", got)
	}

	gotFalse := expandNodeDrainConfig([]interface{}{
		map[string]interface{}{
			"respect_pdb_during_node_pool_deletion": false,
		},
	})
	if gotFalse == nil {
		t.Fatal("expandNodeDrainConfig returned nil")
	}
	if gotFalse.RespectPdbDuringNodePoolDeletion {
		t.Errorf("RespectPdbDuringNodePoolDeletion = true, want false")
	}
	if diff := cmp.Diff([]string{"RespectPdbDuringNodePoolDeletion"}, gotFalse.ForceSendFields); diff != "" {
		t.Errorf("ForceSendFields mismatch (-want +got):\n%s", diff)
	}

	gotTrue := expandNodeDrainConfig([]interface{}{
		map[string]interface{}{
			"respect_pdb_during_node_pool_deletion": true,
		},
	})
	if gotTrue == nil || !gotTrue.RespectPdbDuringNodePoolDeletion {
		t.Fatalf("RespectPdbDuringNodePoolDeletion = %+v, want true", gotTrue)
	}
	if len(gotTrue.ForceSendFields) != 0 {
		t.Errorf("ForceSendFields = %v, want empty", gotTrue.ForceSendFields)
	}
}
