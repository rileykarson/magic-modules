func findInstanceNetworkInterfaceByName(instMap map[string]interface{}, nicName string) (map[string]interface{}, error) {
	rawNics, ok := instMap["networkInterfaces"].([]interface{})
	if !ok {
		return nil, fmt.Errorf("instance has no networkInterfaces")
	}
	for _, rawNic := range rawNics {
		nic, ok := rawNic.(map[string]interface{})
		if !ok {
			continue
		}
		if name, _ := nic["name"].(string); name == nicName {
			return nic, nil
		}
	}
	if len(rawNics) == 1 {
		if nic, ok := rawNics[0].(map[string]interface{}); ok {
			return nic, nil
		}
	}
	return nil, fmt.Errorf("instance has no network interface named %q", nicName)
}

func computeInstanceDeleteAccessConfigs(d *schema.ResourceData, config *transport_tpg.Config, instNetworkInterface map[string]interface{}, project, zone, userAgent, instanceName string) error {
	// Delete any accessConfig that currently exists in instNetworkInterface
	rawAccessConfigs, ok := instNetworkInterface["accessConfigs"].([]interface{})
	if !ok || len(rawAccessConfigs) == 0 {
		return nil // No access configs to delete
	}

	instanceUrl, err := computeInstanceUpdateInstanceURL(d, config)
	if err != nil {
		return fmt.Errorf("error replacing vars for DeleteAccessConfig URL: %w", err)
	}

	nicName, _ := instNetworkInterface["name"].(string)
	for _, rawAc := range rawAccessConfigs {
		ac, ok := rawAc.(map[string]interface{})
		if !ok {
			continue
		}
		acName, _ := ac["name"].(string)

		err = computeInstanceWholeResourceModifyWithWaitErr(
			d,
			config,
			project,
			instanceUrl,
			userAgent,
			"",
			fmt.Sprintf("error deleting old access_config %q: {{"{{"}}err{{"}}"}}", acName),
			fmt.Sprintf("error waiting for old access_config %q deletion: {{"{{"}}err{{"}}"}}", acName),
			"old access_config to delete",
			func(instMap map[string]interface{}) error {
				targetNic, err := findInstanceNetworkInterfaceByName(instMap, nicName)
				if err != nil {
					return err
				}
				if currentAcs, ok := targetNic["accessConfigs"].([]interface{}); ok && len(currentAcs) > 1 {
					remaining := make([]interface{}, 0, len(currentAcs))
					for _, curRaw := range currentAcs {
						if curAc, ok := curRaw.(map[string]interface{}); ok {
							if curName, _ := curAc["name"].(string); curName == acName {
								continue
							}
						}
						remaining = append(remaining, curRaw)
					}
					if len(remaining) > 0 {
						targetNic["accessConfigs"] = remaining
					} else {
						delete(targetNic, "accessConfigs")
					}
				} else {
					delete(targetNic, "accessConfigs")
				}
				return nil
			},
		)
		if err != nil {
			return err
		}
	}
	return nil
}

func computeInstanceAddAccessConfigs(d *schema.ResourceData, config *transport_tpg.Config, instNetworkInterface map[string]interface{}, accessConfigs []interface{}, project, zone, userAgent, instanceName string) error {
	if len(accessConfigs) == 0 {
		return nil
	}

	instanceUrl, err := computeInstanceUpdateInstanceURL(d, config)
	if err != nil {
		return fmt.Errorf("error replacing vars for AddAccessConfig URL: %w", err)
	}

	nicName, _ := instNetworkInterface["name"].(string)
	// Create new ones
	for _, rawAc := range accessConfigs {
		ac, ok := rawAc.(map[string]interface{})
		if !ok {
			continue
		}
		acName, _ := ac["name"].(string)

		err = computeInstanceWholeResourceModifyWithWaitErr(
			d,
			config,
			project,
			instanceUrl,
			userAgent,
			"",
			fmt.Sprintf("error adding new access_config %q: {{"{{"}}err{{"}}"}}", acName),
			fmt.Sprintf("error waiting for new access_config %q addition: {{"{{"}}err{{"}}"}}", acName),
			"new access_config to add",
			func(instMap map[string]interface{}) error {
				targetNic, err := findInstanceNetworkInterfaceByName(instMap, nicName)
				if err != nil {
					return err
				}
				targetNic["accessConfigs"] = []interface{}{ac}
				return nil
			},
		)
		if err != nil {
			return err
		}
	}
	return nil
}

func computeInstanceCreateUpdateWhileStoppedCall(d *schema.ResourceData, config *transport_tpg.Config, networkInterfacePatchObj map[string]interface{}, accessConfigs []interface{}, accessConfigsHaveChanged bool, index int, project, zone, userAgent, instanceName string) func(inst map[string]interface{}) error {

	// Access configs' ip changes when the instance stops invalidating our fingerprint
	// expect caller to re-validate instance before calling patch this is why we expect
	// instance to be passed in
	return func(instance map[string]interface{}) error {
		rawNics, ok := instance["networkInterfaces"].([]interface{})
		if !ok || len(rawNics) <= index {
			return fmt.Errorf("error updating network interface: instance has no network interface at index %d", index)
		}
		instNetworkInterface, ok := rawNics[index].(map[string]interface{})
		if !ok {
			return fmt.Errorf("error updating network interface: invalid network interface type at index %d", index)
		}

		// Access config can run into some issues since we can't tell the difference between
		// the users declared intent (config within their hcl file) and what we have inferred from the
		// server (terraform state). Access configs contain an ip subproperty that can be incompatible
		// with the subnetwork/network we are transitioning to. Due to this we only change access
		// configs if we notice the configuration (user intent) changes.
		if accessConfigsHaveChanged {
			err := computeInstanceDeleteAccessConfigs(d, config, instNetworkInterface, project, zone, userAgent, instanceName)
			if err != nil {
				return err
			}
		}

		instanceUrl, err := computeInstanceUpdateInstanceURL(d, config)
		if err != nil {
			return fmt.Errorf("error replacing vars for UpdateNetworkInterface URL: %w", err)
		}

		err = computeInstanceWholeResourceModifyWithWaitErr(
			d,
			config,
			project,
			instanceUrl,
			userAgent,
			"",
			"Error updating network interface: {{"{{"}}err{{"}}"}}",
			"error waiting for network interface update: {{"{{"}}err{{"}}"}}",
			"network interface to update",
			func(instMap map[string]interface{}) error {
				freshNics, ok := instMap["networkInterfaces"].([]interface{})
				if !ok || len(freshNics) <= index {
					return fmt.Errorf("error updating network interface: instance has no network interface at index %d", index)
				}
				freshNic, ok := freshNics[index].(map[string]interface{})
				if !ok {
					return fmt.Errorf("error updating network interface: invalid network interface type at index %d", index)
				}

				for k, v := range networkInterfacePatchObj {
					if k == "fingerprint" {
						continue
					}
					if v == nil {
						delete(freshNic, k)
					} else {
						freshNic[k] = v
					}
				}
				if _, hasNetIP := networkInterfacePatchObj["networkIP"]; !hasNetIP {
					delete(freshNic, "networkIP")
				}
				if _, hasAlias := networkInterfacePatchObj["aliasIpRanges"]; !hasAlias {
					delete(freshNic, "aliasIpRanges")
				}
				return nil
			},
		)
		if err != nil {
			return err
		}

		if accessConfigsHaveChanged {
			err := computeInstanceAddAccessConfigs(d, config, instNetworkInterface, accessConfigs, project, zone, userAgent, instanceName)
			if err != nil {
				return err
			}
		}
		return nil
	}
}

